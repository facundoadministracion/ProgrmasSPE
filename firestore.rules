rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role.lower();
    }

    function isUserAllowed(userId) {
        let userRole = getUserRole(userId);
        return userRole in ['admin', 'data-entry'];
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                   (request.auth.uid == userId || getUserRole(request.auth.uid) == 'admin');
    }

    match /participants/{participantId} {
      allow read, create, update, delete: if request.auth != null && isUserAllowed(request.auth.uid);
    }
    
    match /novedades/{novedadId} {
      allow read, create: if request.auth != null && isUserAllowed(request.auth.uid);
      allow update, delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    match /asistencias/{asistenciaId} {
        allow read, write: if request.auth != null && isUserAllowed(request.auth.uid);
    }
    
    match /pagos/{pagoId} {
        allow read, write: if request.auth != null && isUserAllowed(request.auth.uid);
    }

    match /paymentRecords/{recordId} {
      allow read, write: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    match /configHistory/{configId} {
      allow read, write: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }
    match /stats/{statId} {
      allow read, write: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    match /configuracionMontos/{docId} {
      allow read, write: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    match /pagosRegistrados/{docId} {
      allow read, write: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    match /paymentHistory/{docId} {
      allow read, write: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }
  }
}
