rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    // NUEVA FUNCIÓN: Verifica si el usuario puede ingresar datos.
    function canWriteData() {
      let userRole = getUserRole(request.auth.uid);
      return request.auth != null && (userRole == 'admin' || userRole == 'data-entry');
    }

    // Regla para la colección 'users'
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Reglas para la colección 'configurations'
    match /configurations/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Reglas para la colección 'configuracionMontos'
    match /configuracionMontos/{docId} {
      allow read, write: if isAdmin();
    }

    // Reglas para la colección 'participants' y sus subcolecciones
    match /participants/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /{path=**}/paymentHistory/{docId} {
      allow read: if request.auth != null;
    }

    // Reglas para la colección 'novedades'
    match /novedades/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Regla para la colección de lotes de pago
    match /paymentHistory/{docId} {
        allow read, write: if isAdmin();
    }

    // Reglas para la colección 'pagosRegistrados'
    match /pagosRegistrados/{document=**} {
      allow read, write: if isAdmin();
    }

    // REGLAS CORREGIDAS Y GRANULARES PARA 'asistencias'
    match /asistencias/{docId} {
      // Permite a cualquier usuario autenticado hacer consultas (verificar duplicados).
      allow list: if request.auth != null;
      // Solo los admins pueden leer un documento específico por su ID.
      allow get: if isAdmin();
      // Permite a 'admin' y 'data-entry' crear nuevos registros.
      allow create: if canWriteData();
      // Solo los admins pueden modificar o borrar.
      allow update, delete: if isAdmin();
    }
  }
}
